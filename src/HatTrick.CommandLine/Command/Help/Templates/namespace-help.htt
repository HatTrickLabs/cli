{?var:blockAt = $.BlockStart}

{$.Target.Name}{($.Target.Help, :blockAt,  $.Target.Name.Length, '.') => GetBlockedContent}

{#if $.Namespaces}
Child namespaces:
{#each $.Namespaces}
{($) => GetNamespaceHelp}
{/each}
{/if}

{#if $.Commands}
Child commands:
{#each $.Commands}
{($) => GetCommandHelp}
{/each}
{/if}

{#if $.Namespaces}
Run {() => GetExecutableName} -? [namespace] to see help content for the above listed namespaces.
{/if}
{#if $.Commands}
Run {() => GetExecutableName} -? [command] to see help content for the above listed commands.
{/if+}
