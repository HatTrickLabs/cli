<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Authors>Jerrod Eiman</Authors>
    <Description>HatTrick Labs command line interface tools.</Description>
    <Company>HatTrick Labs</Company>
    <Copyright>Hat Trick Labs</Copyright>
    <PackageProjectUrl>https://github.com/HatTrickLabs/cli</PackageProjectUrl>
    <PackageIcon>htl-nuget-logo.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Initial public release. Versioned and used internally since 2023 — this release continues that version history rather than resetting to 1.0.</PackageReleaseNotes>
    <RepositoryType>https://github.com/HatTrickLabs/cli</RepositoryType>
    <PackageTags>command line cli</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <EnableNETAnalyzers>False</EnableNETAnalyzers>
    <RunAnalyzersDuringLiveAnalysis>False</RunAnalyzersDuringLiveAnalysis>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Version>2.6.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Outputs\Templates\command-help.httt" />
    <None Remove="Outputs\Templates\namespace-help.httt" />
    <None Remove="Outputs\Templates\namespace-wildcard-help.httt" />
    <None Remove="Outputs\Templates\root-help.httt" />
    <None Remove="Outputs\Templates\usage-help.httt" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Outputs\Templates\command-help.httt" />
    <EmbeddedResource Include="Outputs\Templates\namespace-help.httt" />
    <EmbeddedResource Include="Outputs\Templates\namespace-wildcard-help.httt" />
    <EmbeddedResource Include="Outputs\Templates\root-help.httt" />
    <EmbeddedResource Include="Outputs\Templates\usage-help.httt" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\build\htl-nuget-logo.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HatTrick.Text.Templating" Version="3.0.0" />
  </ItemGroup>

</Project>
